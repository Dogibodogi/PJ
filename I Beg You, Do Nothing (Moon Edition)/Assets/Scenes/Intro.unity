  storySteps:
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: So...They are really sending me there.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '...

'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0.5
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: I think I'm gonna throw up.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: The ship is not even done...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: ' The Union did not have the buget to complete it.'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '

      They just want to reach the moon before the americans.

'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -8753266705223407890, guid: 97a35e2f4ed827d4a88d426b88768006, type: 3}
    individualFadeDuration: 2
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '

      Crazy bastards.'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2406512304624578628, guid: 9a97783606af222448f74c4a8f07df2c, type: 3}
    individualFadeDuration: 0.5
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: 10 days later...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0.5
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: Job's done. We made history today.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '*For a moment, you forget about everything*'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '*Your friends... Your familiy...Your whole life as a human*'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '*Things like that do not matter anymore*'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '*In the grand scheme of things...We are nothing.*'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: ...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: '*You snap back into reality*'
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 7909157490230493669, guid: 9df180c526f100943a167343ee8e6db2, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: It's time to leave. I gotta get back to ship.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 1
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: Launching in 3..
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: 2...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: 1...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: ...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: ...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: 'Why isn''t the engine igniting? '
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 1538773130006195170, guid: 4300781a3f14d5b4d945bde5dea2f5a7, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: 'SON OF A *****!! '
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2406512304624578628, guid: 9a97783606af222448f74c4a8f07df2c, type: 3}
    individualFadeDuration: 1
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: There is nothing left to do. You are stuck here.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: -5364237383851785085, guid: 1d8ec635d5f07e145af09b2a86ce49b1, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: So you just kept walking... and walking...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 6358755690234239126, guid: 5ac86a7828b2b7c4d98287672244833b, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: All hope is lost. You are gonna perish here.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2406512304624578628, guid: 9a97783606af222448f74c4a8f07df2c, type: 3}
    individualFadeDuration: 1
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: The end.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2406512304624578628, guid: 9a97783606af222448f74c4a8f07df2c, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: Wait a minute...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2406512304624578628, guid: 9a97783606af222448f74c4a8f07df2c, type: 3}
    individualFadeDuration: 0.5
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: WHAT'S THAT???.
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2382000799175458472, guid: 4b1de160b9a7bf94aa241fd2f6a2653d, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: WHY... IS THERE ANOTHER SHIP HERE?
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2382000799175458472, guid: 4b1de160b9a7bf94aa241fd2f6a2653d, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: AND WHY DOES IT LOOK SO WEIRD?
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2382000799175458472, guid: 4b1de160b9a7bf94aa241fd2f6a2653d, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: Did the Union send help?
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
    background: {fileID: 2382000799175458472, guid: 4b1de160b9a7bf94aa241fd2f6a2653d, type: 3}
    individualFadeDuration: 0
    characterPortrait: {fileID: 0}
    characterName: 
    dialogueLine: I've got to get inside...
    customTypingSound: {fileID: 0}
  - showText: 1
    useGrayBox: 0
